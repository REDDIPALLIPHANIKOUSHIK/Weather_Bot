# ==============================================================
# WEATHERWISE — ENVIRONMENT VARIABLES
# ==============================================================

# Backend API URL for frontend (leave unset in Vercel for same-origin proxy)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Allowed CORS origins for the FastAPI backend (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server-side Gemini API credentials (NEVER commit real keys or expose as NEXT_PUBLIC_*)
# Used for real-time voice sessions (POST /api/voice/session ephemeral token minting)
# and structured intent extraction. If unset, graceful browser voice fallback and
# deterministic rule-based local intent parsing are activated automatically.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.0-flash
GEMINI_INTENT_MODEL=gemini-2.0-flash

