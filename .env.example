# Local frontend URL for the FastAPI service. Leave unset on Vercel to use
# same-origin /api routing to the backend service.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Local browser origin. Production Services calls are same-origin, so CORS is
# not needed unless you allow a separate site to call the backend directly.
CORS_ORIGINS=http://localhost:3000
# Optional intent extraction. If no key is configured, conservative local parsing is used.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Set this as a server-side Vercel environment variable, never NEXT_PUBLIC_*.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# For other OpenAI-compatible services, use LLM_PROVIDER=openai_compatible with these:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=local


# Gemini Live voice (server-side only)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
