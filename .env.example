# Frontend public URL for the FastAPI service. Keep this value free of secrets.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Backend CORS origins, comma-separated.
CORS_ORIGINS=http://localhost:3000
# Optional intent extraction. If no key is configured, conservative local parsing is used.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# For other OpenAI-compatible services, use LLM_PROVIDER=openai_compatible with these:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=local
